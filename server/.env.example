NODE_ENV=production            # use "development" locally
PORT=5000                      # local only; ignored on Vercel

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/digital-heroes?retryWrites=true&w=majority

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Frontend URL(s) allowed by CORS. Comma separate for several. No trailing slash needed.
CLIENT_URL=http://localhost:5173

# Stripe (Dashboard > Developers)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx   # Product catalog > your monthly price > Price ID
STRIPE_PRICE_YEARLY=price_xxx

# Cloudinary (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Optional: used only by `npm run seed`
ADMIN_EMAIL=admin@digitalheroes.co.in
ADMIN_PASSWORD=ChangeThisPassword123!
